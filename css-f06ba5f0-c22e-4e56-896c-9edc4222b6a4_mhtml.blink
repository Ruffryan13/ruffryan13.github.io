@charset "utf-8";

.hero { text-align: center; padding: 56px 0px 72px; position: relative; }

.hero-badge { display: inline-flex; align-items: center; gap: 8px; background: var(--postit); color: var(--text-main); font-family: var(--font-heading); font-size: 0.95rem; font-weight: 700; padding: 9px 20px; border-radius: var(--wobbly-2); margin-bottom: 26px; border: 2.5px solid var(--border); box-shadow: var(--shadow-sm); transform: rotate(-2deg); }

.hero-badge-dot { width: 10px; height: 10px; background: var(--accent); border-radius: var(--wobbly-circle); border: 2px solid var(--border); animation: 2s ease-in-out 0s infinite normal none running pulse; }

@keyframes pulse { 
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.7); }
}

.hero h1 { font-family: var(--font-heading); font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 700; line-height: 1.05; letter-spacing: -1.5px; margin-bottom: 22px; color: var(--text-main); }

.hero h1 .accent-text { color: var(--accent); text-decoration-line: underline; text-decoration-thickness: initial; text-decoration-style: wavy; text-decoration-color: var(--accent); text-underline-offset: 6px; }

.hero-subtitle { font-size: 1.15rem; color: var(--text-secondary); max-width: 540px; margin: 0px auto 36px; line-height: 1.55; font-family: var(--font-body); }

.hero-buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }

.hero-buttons .btn { padding: 14px 28px; font-size: 1.15rem; }

.user-status { margin-top: 12px; font-family: var(--font-body); font-size: 1rem; color: var(--text-dim); display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; background: var(--postit); border: 2.5px solid var(--border); border-radius: var(--wobbly-2); box-shadow: var(--shadow-sm); transform: rotate(-1deg); }

.hub-flashes { max-width: 580px; margin: 0px auto 26px; display: flex; flex-direction: column; gap: 10px; animation: 0.4s ease 0s 1 normal none running fadeInUp; }

.hub-flash { background: var(--surface); border-radius: var(--wobbly-3); padding: 14px 18px; font-family: var(--font-body); font-size: 1rem; font-weight: 400; border: 2.5px solid var(--border); display: flex; align-items: flex-start; gap: 10px; box-shadow: var(--shadow-sm); transform: rotate(-0.5deg); }

.hub-flash:nth-child(2n) { transform: rotate(0.5deg); }

.hub-flash.success { background: rgb(212, 245, 233); color: var(--secondary); border-color: var(--secondary); }

.hub-flash.error { background: var(--postit); color: var(--accent); border-color: var(--accent); }

.section-title { text-align: center; margin-bottom: 48px; }

.section-title h2 { font-family: var(--font-heading); font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 700; letter-spacing: -0.8px; margin-bottom: 10px; }

.section-title p { color: var(--text-dim); font-size: 1.05rem; font-family: var(--font-body); }

.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; margin-bottom: 80px; }

.card { background: var(--surface); border: 2.5px solid var(--border); border-radius: var(--wobbly-1); padding: 36px 24px 32px; text-decoration: none; color: inherit; transition: var(--transition); display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; box-shadow: var(--shadow-md); }

.card:nth-child(2n) { transform: rotate(-1deg); }

.card:nth-child(2n+1) { transform: rotate(1deg); }

.card:hover { transform: translate(-3px, -3px) rotate(0deg); border-color: var(--accent); box-shadow: var(--shadow-lg); }

.card > * { position: relative; }

.card-icon-wrap { width: 76px; height: 76px; border-radius: var(--wobbly-circle); display: flex; align-items: center; justify-content: center; margin-bottom: 22px; transition: var(--transition); border: 2.5px solid var(--border); box-shadow: var(--shadow-sm); }

.card-icon-wrap.memes { background: var(--postit); color: var(--accent); }

.card-icon-wrap.media { background: rgb(221, 232, 255); color: var(--secondary); }

.card-icon-wrap.friends { background: rgb(212, 245, 233); color: var(--secondary); }

.card-icon-wrap.chat { background: var(--postit); color: var(--accent); }

.card:hover .card-icon-wrap { transform: rotate(-12deg) scale(1.08); box-shadow: var(--shadow-md); }

.card h3 { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 700; margin-bottom: 10px; letter-spacing: -0.3px; }

.card p { color: var(--text-dim); font-size: 0.95rem; line-height: 1.55; max-width: 240px; font-family: var(--font-body); }

.card-arrow { margin-top: 22px; width: 44px; height: 44px; border-radius: var(--wobbly-circle); background: var(--surface); border: 2.5px solid var(--border); display: flex; align-items: center; justify-content: center; color: var(--text-dim); transition: var(--transition); box-shadow: var(--shadow-sm); }

.card:hover .card-arrow { background: var(--accent); border-color: var(--border); color: rgb(255, 255, 255); transform: translateX(4px) rotate(-5deg); box-shadow: var(--shadow-md); }

.hub-widget-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 22px; flex-wrap: wrap; }

.hub-widget-toolbar .hint { color: var(--text-dim); font-family: var(--font-body); font-size: 0.95rem; }

.stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-bottom: 80px; }

.stat-item { text-align: center; padding: 26px 20px; background: var(--surface); border: 2.5px solid var(--border); border-radius: var(--wobbly-2); box-shadow: var(--shadow-sm); transition: var(--transition); transform: rotate(-1deg); }

.stat-item:nth-child(2n) { transform: rotate(1deg); }

.stat-item:hover { transform: translate(-2px, -2px) rotate(0deg); box-shadow: var(--shadow-md); }

.stat-icon { width: 52px; height: 52px; margin: 0px auto 14px; border: 2.5px solid var(--border); border-radius: var(--wobbly-circle); display: flex; align-items: center; justify-content: center; color: var(--accent); background: var(--postit); box-shadow: var(--shadow-sm); transform: rotate(-4deg); }

.stat-value { font-family: var(--font-heading); font-size: 1.75rem; font-weight: 700; color: var(--text-main); margin-bottom: 4px; letter-spacing: -0.3px; }

.stat-label { font-size: 0.95rem; color: var(--text-dim); font-weight: 400; font-family: var(--font-body); }

.cta-banner { background: var(--postit); border: 3px solid var(--border); border-radius: var(--wobbly-1); padding: 56px 40px; text-align: center; position: relative; box-shadow: var(--shadow-lg); transform: rotate(-0.5deg); transition: var(--transition); }

.cta-banner:hover { transform: rotate(0deg) translate(-2px, -2px); }

.cta-banner h2 { font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--text-main); margin-bottom: 14px; letter-spacing: -0.8px; }

.cta-banner p { color: var(--text-main); font-family: var(--font-body); font-size: 1.1rem; margin-bottom: 28px; max-width: 460px; margin-left: auto; margin-right: auto; }

.cta-banner .btn { background: var(--accent); color: rgb(255, 255, 255); font-family: var(--font-heading); font-size: 1.15rem; padding: 14px 32px; }

.cta-banner .btn:hover { background: var(--accent); color: rgb(255, 255, 255); transform: translate(-2px, -2px) rotate(-2deg); }

@media (max-width: 900px) {
  .grid { grid-template-columns: 1fr; gap: 18px; }
  .stats-row { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 600px) {
  .hero { padding: 28px 0px 48px; }
  .hero h1 { font-size: 2.2rem; letter-spacing: -1px; }
  .hero-subtitle { font-size: 1rem; }
  .stats-row { grid-template-columns: 1fr 1fr; gap: 14px; }
  .cta-banner { padding: 40px 24px; }
  .cta-banner h2 { font-size: 1.6rem; }
}